{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workshop-message-board",
  "main": "./server.js",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_DB_NAME",
      "database_id": "YOUR_DB_ID",
      "remote": true
    }
  ]
}